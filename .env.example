# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Connect (or Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with sb_publishable_). Safe for the browser; RLS protects the data.
# Never put the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the site (used for SEO / share links). Localhost in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
